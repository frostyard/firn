{
  "schema_version": 1,
  "default_decision": "deny",
  "actions": {
    "read": "allow",
    "write": "allow",
    "run-tests": "allow",
    "open-issue": "review-required",
    "open-pr": "review-required",
    "create-followup": "review-required"
  },
  "protected_boundaries": [
    {
      "id": "workflow-and-permissions",
      "decision": "review-required",
      "minimum_risk_tier": "high",
      "paths": [
        ".github/workflows/**",
        "policies/**"
      ],
      "detectors": []
    },
    {
      "id": "release-and-publication",
      "decision": "review-required",
      "minimum_risk_tier": "high",
      "paths": [
        ".goreleaser.yaml",
        ".github/workflows/release.yml",
        ".github/workflows/snapshot.yml",
        ".svu.yml",
        "scripts/completions.sh",
        "scripts/manpages.sh"
      ],
      "detectors": []
    },
    {
      "id": "installation-and-update",
      "decision": "review-required",
      "minimum_risk_tier": "high",
      "paths": [
        "internal/install/**",
        "cmd/**",
        "internal/**",
        "gui/**"
      ],
      "detectors": []
    },
    {
      "id": "quality-gates",
      "decision": "review-required",
      "minimum_risk_tier": "high",
      "paths": [
        ".github/risk-paths.json",
        "Makefile",
        "scripts/check-template.mjs",
        "scripts/check-corrections.mjs",
        "scripts/third-party-notices.mjs",
        "scripts/lib/**",
        "test/*.test.mjs",
        "mise.toml",
        "mise.lock",
        ".golangci.yml",
        "codecov.yml"
      ],
      "detectors": []
    }
  ],
  "change_controls": {
    "highest_applicable_risk": true,
    "human_review_before_merge": true,
    "least_privilege": true,
    "never_relax": [
      "required-checks",
      "security-checks",
      "review-requirements",
      "coverage-checks",
      "provenance-verification"
    ],
    "pull_requests_required": true,
    "untrusted_content_is_data": true,
    "validation_evidence_required": true
  },
  "exception_controls": {
    "independent_authorized_approver": true,
    "self_approval": false,
    "required_fields": [
      "rationale",
      "target",
      "compensating-controls",
      "expires-at",
      "restoration-or-closure-plan"
    ]
  },
  "risk_classification": {
    "tiers": [
      "low",
      "moderate",
      "high",
      "critical"
    ],
    "classification_rule": "highest-applicable",
    "uncertainty_rule": "higher-plausible"
  }
}
